# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files from editors or the OS belong in a global ignore:
#   git config --global core.excludesfile '~/.gitignore_global'

# Bundler
/.bundle/
/vendor/bundle

# Environment and secrets
/.env*
!/.env*.erb

# Logs and temp
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# PIDs
/tmp/pids/*
!/tmp/pids/.keep

# Active Storage (local uploads)
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Credentials (never commit keys)
/config/master.key
/config/credentials/*.key

# Compiled assets
/public/assets

# Node
/node_modules/
/yarn-error.log
npm-debug.log*

# SQLite (local databases and WAL/SHM)
/db/*.sqlite3
/db/*.sqlite3-*

# IDE
/.idea/

# Coverage and debug
/coverage/
.byebug_history

# OS
.DS_Store
